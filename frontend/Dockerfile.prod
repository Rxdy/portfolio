# Étape 1 — build de l'application
# --platform=$BUILDPLATFORM : npm ci/build compilent du JS pur, pas de code
# natif — tourner nativement plutôt que sous émulation QEMU pour arm64 est
# nettement plus rapide. Seule l'étape 2 (nginx) doit cibler l'architecture finale.
FROM --platform=$BUILDPLATFORM node:22-alpine AS build
WORKDIR /app
ARG VITE_UMAMI_WEBSITE_ID
ENV VITE_UMAMI_WEBSITE_ID=$VITE_UMAMI_WEBSITE_ID
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
RUN npm run build

# Étape 2 — service statique nginx (avec fallback SPA)
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

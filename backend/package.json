  },
  "devDependencies": {
    "@types/node": "^22.17.1",
    "@types/nodemailer": "^6.4.17",
    "@vitest/coverage-v8": "^3.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }

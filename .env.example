# Copier en .env (jamais commité) et renseigner un vrai serveur SMTP.
# rxdy.fr n'a pas de vraie boîte mail (offre OVH = redirections uniquement),
# donc on envoie via le SMTP de Gmail — voir backend/src/services/mailer.ts.
# Exemple avec smtp.gmail.com (SMTP_PASS = mot de passe d'application Google,
# pas le mot de passe du compte) :
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rudyalvs@gmail.com
SMTP_PASS=
SMTP_FROM="Portfolio rxdy.fr <rudyalvs@gmail.com>"
CONTACT_TO=rudyalvs@gmail.com

# Umami (analytics auto-hébergé, https://analytics.rxdy.fr)
# UMAMI_APP_SECRET : chaîne aléatoire longue, ex. `openssl rand -hex 32`
# UMAMI_DB_PASSWORD : mot de passe de la base Postgres dédiée à Umami
# VITE_UMAMI_WEBSITE_ID : généré dans le dashboard Umami après le premier
# démarrage (Settings > Websites > Add website) — build-time, pas au runtime.
UMAMI_APP_SECRET=
UMAMI_DB_PASSWORD=
VITE_UMAMI_WEBSITE_ID=

# Résumé quotidien des visites par email (backend/src/scheduler.ts) — même
# UMAMI_WEBSITE_ID que ci-dessus. UMAMI_ADMIN_USERNAME/PASSWORD : le compte
# admin Umami (pas de clé API dédiée dans cette version auto-hébergée).
UMAMI_WEBSITE_ID=
UMAMI_ADMIN_USERNAME=
UMAMI_ADMIN_PASSWORD=
STATS_EMAIL_TO=rudyalvs@gmail.com
